format = """\
[PLEFT](fg:{{color4}})[ $username ](bg:{{color4}} fg:{{background}})[ $directory ](bg:{{color5}} fg:{{background}})[ ARCH ](bg:{{color6}} fg:{{color4}})[ $time ](bg:{{color8}} fg:{{foreground}})[PRIGHT](fg:{{color8}})
$line_break\
$character
"""

add_newline = false

[directory]
format = "[$path]($style)[$read_only]($read_only_style)"
style = "bg:{{color5}} fg:{{background}}"
read_only = "󰌾 "
truncation_length = 1
fish_style_pwd_dir_length = 1
home_symbol = "~"

[character]
success_symbol = "[❯](bold white)"
error_symbol = "[](bold white)"
vimcmd_symbol = "[](bold white)"

[username]
format = "[$user]($style)"
style_user = "bg:{{color4}} fg:{{background}}"
style_root = "bg:{{color4}} fg:{{background}}"
disabled = false
show_always = true

[hostname]
ssh_only = true
format = "[$hostname ]($style)"
style = "bg:{{color1}} fg:{{background}}"
disabled = false

[time]
disabled = false
time_format = "%R"
format = "[$time]($style)"
style = "bg:{{color8}} fg:{{foreground}}"
use_12hr = true

