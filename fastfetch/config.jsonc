{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " •  "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "color": {
                "user": "32",
                "at": "37",
                "host": "32"
            }
        },
        "break",
        {
            "type": "os",
            "key": "os     ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            "format": "{pacman} (pacman)",
            "key": "pkgs   ",
            "keyColor": "33"
        },
        {
            "type": "shell",
            "key": "shell  ",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": "term   ",
            "keyColor": "33"
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "wm     ",
            "keyColor": "33"
        },
        {
            "type": "cpu",
            "key": "cpu    ",
            "keyColor": "33",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "ram    ",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "uptime ",
            "keyColor": "33"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "key": "colors "
        },
        "break"
    ]
}
