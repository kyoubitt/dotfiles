{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "type": "file",
        "color": {
            "1": "white"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌──────────┐"
        },
        {
            "type": "title",
            "key": "│  user   │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{user-name}"
        },
        {
            "type": "uptime",
            "key": "│  uptime │",
            "keyColor": "white",
            "outputColor": "white"
        },
        {
            "type": "os",
            "key": "│  distro │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{name} {arch}"
        },
        {
            "type": "packages",
            "key": "│  pkg    │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{pacman} (pacman)"
        },
        {
            "type": "wm",
            "key": "│  wm     │",
            "keyColor": "white",
            "outputColor": "white"
        },
        {
            "type": "terminal",
            "key": "│  term   │",
            "keyColor": "white",
            "outputColor": "white"
        },
        {
            "type": "shell",
            "key": "│  shell  │",
            "keyColor": "white",
            "outputColor": "white"
        },
        {
            "type": "cpu",
            "key": "│  cpu    │",
            "keyColor": "white",
            "outputColor": "white"
        },
        {
            "type": "gpu",
            "key": "│  gpu    │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{name}"
        },
        {
            "type": "disk",
            "key": "│  disk   │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{1} / {2}"
        },
        {
            "type": "memory",
            "key": "│  memory │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{used} / {total}"
        },
        {
            "type": "swap",
            "key": "│  swap   │",
            "keyColor": "white",
            "outputColor": "white",
            "format": "{used} / {total}"
        },
        {
            "type": "colors",
            "key": "│  colors │",
            "keyColor": "white",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "└──────────┘"
        }
    ]
}
