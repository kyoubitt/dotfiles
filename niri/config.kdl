
// Startup Applications
spawn-at-startup "~/.config/niri/scripts/startup.sh"

// General Settings
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

output "eDP-1" {
    mode "1920x1080@60.024"
    scale 1
}

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"
}
}

    touchpad {
        tap
        natural-scroll
}

    focus-follows-mouse
    workspace-auto-back-and-forth
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Future-cursors-Black"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 5000
}

gestures {
    // A press in the top-left corner opened the overview; the screenshot overlay needs the corners (overview: Mod+Escape).
    hot-corners {
        off
    }
}

overview {
    zoom 0.65
    backdrop-color "#0b0b10"
    workspace-shadow {
        softness 40
        spread 8
        offset x=0 y=6
        color "#000000cc"
    }
}

// The wallpaper daemon used to draw the sharp wallpaper behind the overview; the shell now draws a blurred one there
// (quickshell:wOverviewBackdrop below), so the daemon stays out of the backdrop.

binds {
    // Shortcuts Panel
    Mod+Shift+Escape { show-hotkey-overlay; }
    Mod+A hotkey-overlay-title="Application Launcher" { spawn-sh "qs -c zerd ipc call search toggle"; }
    Mod+Shift+A hotkey-overlay-title="Pin list" { spawn-sh "qs -c zerd ipc call dock launcher"; }

    // Application Shortcuts
    Mod+Return hotkey-overlay-title="Open Terminal: Ghostty" { spawn-sh "ghostty"; }
    Mod+Shift+Q hotkey-overlay-title="Lock Screen" { spawn-sh "qs -c zerd ipc call lockScreen lock"; }
    Mod+Shift+E hotkey-overlay-title="Power Menu" { spawn-sh "qs -c zerd ipc call sessionScreen toggle"; }
    Mod+B hotkey-overlay-title="Open Browser: Firefox" { spawn-sh "firefox"; }
    Mod+E hotkey-overlay-title="File Manager: Thunar" { spawn-sh "thunar"; }
    Mod+V hotkey-overlay-title="Clipboard History" { spawn-sh "qs -c zerd ipc call clipboard toggle"; }
    Mod+W hotkey-overlay-title="Wallpapers" repeat=false { spawn-sh "qs -c zerd ipc call wallpaper toggle"; }
    Mod+Shift+W hotkey-overlay-title="Toggle Desktop Widgets" { spawn-sh "qs -c zerd ipc call widgets toggleAll"; }

    // Media Keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh volume_up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh volume_down"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh brightness_up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh brightness_down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh volume_mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh mic_mute"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh next_track"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh play_pause"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh play_pause"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "~/.config/scripts/media-control.sh prev_track"; }

    // Window Management
    Mod+Q repeat=false { spawn-sh "~/.config/quickshell/zerd/scripts/close-window.sh"; }
    Mod+H { focus-column-left; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    // Move windows within workspace
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-right; }

    // Move to workspace edges
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End { move-column-to-last; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // Workspace Management
    Mod+Escape hotkey-overlay-title="Open Overview" repeat=false { toggle-overview; }
    Mod+WheelScrollDown cooldown-ms=100 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=100 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=100 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=100 { move-column-to-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }

    // Numbered Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Alt+Tab hotkey-overlay-title="Window Switcher" { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/switcher-key.sh next"; }
    Alt+Shift+Tab hotkey-overlay-title="Window Switcher (back)" { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/switcher-key.sh prev"; }

    // Layout Controls
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+BracketLeft { set-column-width "-10%"; }
    Mod+BracketRight { set-column-width "+10%"; }
    Mod+Shift+BracketLeft { set-window-height "-10%"; }
    Mod+Shift+BracketRight { set-window-height "+10%"; }
    Mod+Ctrl+WheelScrollDown { set-window-height "-5%"; }
    Mod+Ctrl+WheelScrollUp { set-window-height "+5%"; }

    // Window Modes
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+F { fullscreen-window; }
    Mod+M { maximize-column; }
    // Orbit: open it, or bring it back into view if it is already open
    Mod+Shift+M hotkey-overlay-title="Orbit (music)" { spawn-sh "qs -c zerd ipc call music launch"; }

    // Utils
    Mod+S hotkey-overlay-title="Screenshot" repeat=false { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/screenshot-key.sh region"; }
    Print hotkey-overlay-title="Screenshot" repeat=false { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/screenshot-key.sh region"; }
    Shift+Print hotkey-overlay-title="Screenshot: whole screen" repeat=false { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/screenshot-key.sh screen"; }
    Alt+Print hotkey-overlay-title="Screenshot: a window" repeat=false { spawn "sh" "-c" "$HOME/.config/quickshell/zerd/scripts/screenshot-key.sh window"; }
    Mod+Alt+S hotkey-overlay-title="Screenshot (niri)" { screenshot; }
    Mod+Shift+S hotkey-overlay-title="Open in Satty" { spawn-sh "satty --filename \"$(find ~/Pictures/Screenshots -name '*.png' -printf '%T@ %p\\n' | sort -n | tail -1 | cut -d' ' -f2-)\""; }
    Mod+Ctrl+S { screenshot-window write-to-disk=true; }
    Mod+P hotkey-overlay-title="Pick Color" { spawn-sh "hyprpicker -a -n"; }
}

layout {
    gaps 8
    center-focused-column "on-overflow"
    background-color "#00000000"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
}

    focus-ring {
        width 2
        active-color "#91BFF4bb"
        inactive-color "#91BFF4bb"
    }



    insert-hint {
        off
        color "#141414"
}

}

// Animation Settings
animations {
    slowdown 0.8
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
}
    window-open {
        duration-ms 200
        curve "ease-out-quad"
}
    window-close {
        duration-ms 240
        curve "linear"
        // Shrinks a little, drifts up and fades out; the ease-out is done in the shader.
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float e = 1.0 - pow(1.0 - p, 3.0);
                float s = 1.0 - 0.07 * e;
                vec2 g = (coords_geo.xy - vec2(0.5)) / s + vec2(0.5);
                g.y += 0.025 * e / s;
                vec3 t = niri_geo_to_tex * vec3(g, 1.0);
                vec4 color = texture2D(niri_tex, t.st);
                if (g.x < 0.0 || g.x > 1.0 || g.y < 0.0 || g.y > 1.0) color = vec4(0.0);
                return color * (1.0 - e);
            }
        "
}
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
}
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
}
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
}
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
}
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
}
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
}
}

// Window Rules
// Application-specific rules
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Spotify doesn't support real window transparency itself (proprietary
// Electron build), so this blends the whole window at the compositor level.
// Paired with a Marketplace CSS snippet that strips Spotify's own solid
// backgrounds, so it reads as glassy instead of just uniformly dimmed.
window-rule {
    match app-id=r#"^Spotify$"#
    opacity 0.90
}

// Thunar's GTK3 surface has no real per-pixel alpha support either (tested:
// giving its theme rgba() backgrounds did nothing), so same fix as Spotify -
// blend the whole window at the compositor level instead.
window-rule {
    match app-id=r#"^thunar$"#
    opacity 0.65
}

window-rule {
    match app-id=r#"firefox"#
    match app-id=r#"google-chrome"#
    match app-id=r#"code"#
    match app-id=r#"obsidian$"#
    open-maximized true
}

// File dialogs - Open/Save/Select
window-rule {
    match title=r#".*(Open|Save|Select).*"#
    match title=r#".*File.*"#
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    open-floating true
    default-column-width { proportion 0.5;
}
    max-width 800
    max-height 1000
}

// System / auth dialogs
window-rule {
    match title=r#".*Sign in - Google Accounts — Mozilla Firefox"#
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    match app-id=r#"zenity"#
    match app-id=r#"org\.kde\.polkit-kde-authentication-agent-1"#
    match title=r#".*Authentication.*"#
    open-floating true
}

// Screenshare picker - the portal can't attach it to the app asking for it,
// so it opened unfocused and hid behind fullscreen windows (Vesktop).
// Forcing focus pulls it on top.
window-rule {
    match app-id=r#"^xdg-desktop-portal-gnome$"#
    open-floating true
    open-focused true
}

// Password managers
window-rule {
    match app-id=r#"org\.keepassxc\.KeePassXC"# title=r#".*Auto-Type.*"#
    match app-id=r#"Bitwarden"# title=r#".*unlock.*"#
    open-floating true
}

// Notification and system utilities
window-rule {
    match app-id=r#"nm-connection-editor"#
    match app-id=r#"blueman-manager"#
    match app-id=r#"pavucontrol"#
    open-floating true
}

// Global window appearance
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// Frosted-glass look on (almost) every window - ported from hakuspace's
// niri rules.kdl. This is also what makes the overview itself read as
// "blurred": niri has no separate overview-blur knob, the overview just
// shows live/scaled window content, so blurring windows here is what
// blurs the overview too. Placed before the app-specific background-effect
// rules below so xray/blur there still apply (last-match-wins per field);
// noise/saturation only need setting once, here.
window-rule {
    match app-id=r#".*"#
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 2
    }
}

// Inactive window transparency
window-rule {
    match is-active=false
    opacity 0.9
}

// Environment Variables



environment {
    DISPLAY ":2"
    GDK_BACKEND "wayland"
    GSK_RENDERER "gl"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_STYLE_OVERRIDE "kvantum"
    SDL_VIDEODRIVER "wayland"
    _JAVA_AWT_WM_NONREPARENTING "1"
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "24"
}

layer-rule {
    match namespace="quickshell:wBackground"
    place-within-backdrop true
}

layer-rule {
    match namespace="^quickshell:wOverviewBackdrop$"
    place-within-backdrop true
}

window-rule {
    match is-active=true
    shadow {
        off
    }
}



window-rule {
    // The screenshot editor (modules/bars/ScreenshotEditor.qml): a floating window in the middle, not a tile.
    match title="^zerd-screenshot$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 820; }
}

window-rule {
    match app-id="com.mitchellh.ghostty"
    geometry-corner-radius 0
    clip-to-geometry true
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="vesktop"
    geometry-corner-radius 0
    clip-to-geometry true
    opacity 0.95
}

window-rule {
    match app-id="firefox"
    geometry-corner-radius 0
    clip-to-geometry true
}
window-rule {
    match app-id="cursor"
    match app-id="code"
    opacity 0.75
}

window-rule {
    // The shell's settings window (modules/bars/SettingsWindow.qml).
    match title="^zerd-settings$"
    open-floating true
    default-column-width { fixed 940; }
    default-window-height { fixed 640; }
}

window-rule {
    // File chooser opened from the settings (profile picture): a floating dialog, not a tile.
    match title="^Profile picture"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    // Murmur (modules/music): a real app window, so it opens maximised, not as a small floating card.
    match title="^Orbit$"
    open-maximized true
    // Focus it when it opens, so it comes to the front instead of sitting off-screen next to the focused window.
    open-focused true
}

